{
  "name": "jit-api",
  "version": "1.0.0",
  "description": "Just-In-Time Protocol Synthesis Framework: Dynamic-to-Static API Generation using TypeSafe (Jev)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "jit-api": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin/cli.js",
    "public",
    "specs",
    "benchmark",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch index.ts",
    "demo": "tsx examples/demo_lifecycle.ts",
    "demo:needle": "tsx examples/demo_needle_fallback.ts",
    "demo:py": "PYTHONPATH=python /home/toby/miniconda3/envs/toby/bin/python python/examples/demo_lifecycle.py",
    "example:ts:server": "tsx docs/examples/ts_server.ts",
    "example:ts:client": "tsx docs/examples/ts_client.ts",
    "example:py:server": "PYTHONPATH=python /home/toby/miniconda3/envs/toby/bin/python docs/examples/py_server.py",
    "example:py:client": "PYTHONPATH=python /home/toby/miniconda3/envs/toby/bin/python docs/examples/py_client.py",
    "test": "vitest run",
    "test:py": "PYTHONPATH=python /home/toby/miniconda3/envs/toby/bin/pytest python/tests/ -v"
  },
  "keywords": [
    "jit",
    "api",
    "typesafe",
    "jev",
    "protocol-synthesis",
    "grpc",
    "zod",
    "pydantic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/ws": "^8.18.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
