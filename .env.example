# TypeSafe API Key (obtain from https://console.typesafe.ai/settings/keys)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# LINE Messaging API (obtain from LINE Developers Console)
# LINE_CHANNEL_SECRET=your_line_channel_secret_here
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# TARGET_C_USER_ID=U1234567890abcdef1234567890abcdef

# Supabase (obtain from Supabase Dashboard -> Settings -> API)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_service_role_key

# Google Sheets Plugin (obtain via Google Apps Script Web App URL or GCP Console)
# GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec
# GOOGLE_SHEETS_SPREADSHEET_ID=1A2B3C4D5E6F7G8H9I0J
# GOOGLE_SHEETS_API_KEY=your_google_api_key

# Upstash Serverless Redis (obtain from Upstash Console)
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Notion Database Plugin (obtain from Notion Developers Integration)
# NOTION_API_KEY=secret_your_notion_api_key
# NOTION_DATABASE_ID=your_32_char_database_id

# Notification Channels (Discord, Telegram, Slack)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Auth Providers (Firebase & Clerk)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# CLERK_SECRET_KEY=sk_test_...
